#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = [
#     "jinja2>=3.1.6",
#     "librosa>=0.11.0",
#     "matplotlib>=3.10.9",
#     "numpy>=2.4.6",
#     "pandas>=3.0.3",
#     "plotly>=6.7.0",
#     "psutil>=7.2.2",
#     "rich>=15.0.0",
#     "scipy>=1.17.1",
#     "soundfile>=0.13.1",
