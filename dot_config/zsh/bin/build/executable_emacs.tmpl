#!/usr/bin/env zsh
set -e
set -o pipefail

FORCE_NEW=false

CFLAGS="{{ .dev.compilers.ccflags }}"
CC="ccache {{ .dev.compilers.cc }}"

usage() {
    local prog=${${(%):-%x}:t}

    echo "Usage:"
    echo "  $prog [options] <emacs-version>"
    echo
    echo "Example:"
    echo "  $prog 30.2"
    echo "  $prog --force-new 30.2"
    echo "  $prog --c-flags '-O2 -pipe' 30.2"
    echo "  $prog -cc clang 30.2"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force-new)
            FORCE_NEW=true
            shift
            ;;
        --c-flags)
            if [[ -z "$2" || "$2" == --* ]]; then
                print -u2 "Error: --c-flags requires a string"
                exit 1
            fi
            CFLAGS="$2"
            shift 2
            ;;
        -cc)
            if [[ -z "$2" || "$2" == --* ]]; then
                print -u2 "Error: -cc requires a compiler"
                exit 1
            fi
            CC="$2"
            shift 2
            ;;
        --help|-h)
            usage
            ;;
        -*)
            print -u2 "Unknown argument: $1"
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

[[ $# -eq 1 ]] || usage

EMACS_VERSION="$1"

clone_dir="{{ .dev.directories.clone_dir }}"
build_root="$clone_dir/emacs"
prefix="$HOME/.local_builds/emacs_$EMACS_VERSION"

tarball="emacs-$EMACS_VERSION.tar.xz"
src_dir="$build_root/emacs-$EMACS_VERSION"
url="https://ftp.gnu.org/gnu/emacs/$tarball"

mkdir -p "$build_root"
cd "$build_root"

if [[ "$FORCE_NEW" == true ]]; then
    rm -rf "$src_dir"
    rm -f "$tarball"
fi

if [[ ! -f "$tarball" ]]; then
    echo "Downloading Emacs $EMACS_VERSION..."
    curl -fL -o "$tarball" "$url"
fi

if [[ ! -d "$src_dir" ]]; then
    echo "Extracting..."
    tar xf "$tarball"
fi

cd "$src_dir"

echo "Building Emacs $EMACS_VERSION..."

make clean >/dev/null 2>&1 || true

#export CC
#export CFLAGS

./configure \
    --prefix="$prefix" \
    --disable-silent-rules

make \
    -j"$(getconf _NPROCESSORS_ONLN)"

echo "Installing into $prefix"

mkdir -p "$prefix"

make install

echo
echo "Emacs $EMACS_VERSION installed successfully."
echo "Prefix: $prefix"
echo
echo "Executable:"
echo "  $prefix/bin/emacs"
echo
echo "Compiler:"
echo "  $CC"
echo
echo "CFLAGS:"
echo "  $CFLAGS"
