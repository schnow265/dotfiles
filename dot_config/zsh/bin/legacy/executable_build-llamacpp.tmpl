#!/bin/bash
set -eo pipefail

clone_dir="{{ .dev.directories.clone_dir }}"
repo_dir="$clone_dir/llama.cpp"

mkdir -p "$clone_dir"
cd "$clone_dir"

if [ -d "$repo_dir" ]; then
    cd "$repo_dir"
    git pull
else
    git clone git@github.com:ggml-org/llama.cpp.git --depth=1
    cd "$repo_dir"
fi

#source ~/vulkan/1.4.341.1/setup-env.sh

cmake_cmd=(
    cmake
    -S .
    -B build
    -D CMAKE_C_COMPILER_LAUNCHER=ccache
    -D CMAKE_CXX_COMPILER_LAUNCHER=ccache
    -D GGML_HIP=OFF
    -D GGML_HIP_ROCWMMA_FATTN=ON
    -D GGML_BLAS=OFF
    -D GGML_BLAS_VENDOR=OpenBLAS
    -D GGML_VULKAN=OFF
    -D AMDGPU_TARGETS=gfx1030
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX="{{ .dev.directories.source_install_dir }}"
    -D CMAKE_CXX_FLAGS="{{ .dev.compilers.cxxflags }}"
    -D CMAKE_CC_FLAGS="{{ .dev.compilers.ccflags }}"
    -D CMAKE_EXE_LINKER_FLAGS="{{ .dev.compilers.linkerflags }}"
    -G Ninja
)

CC="{{ .dev.compilers.cc }}" \
    CXX="{{ .dev.compilers.cxx }}" \
    HIPCXX="$(hipconfig -l)/clang" \
    HIP_PATH="$(hipconfig -R)" \
    "${cmake_cmd[@]}"

cmake --build build --config Release --target install
