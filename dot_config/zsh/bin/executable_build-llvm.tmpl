#!/usr/bin/env zsh
set -e
set -o pipefail

SKIP_UPDATE=false
INSTALL=false
SHALLOW_CLONE=false
FORCE_NEW=false
NO_BUILD=false

INST_DIR_SUFFIX=""

LLVM_TARGETS=host # only build for host arcitecture (=> no cross compilers)
LLVM_PROJECTS="clang"   # default
LLVM_RUNTIMES=""

CFLAGS="{{ .dev.compilers.ccflags }}"
CXXFLAGS="{{ .dev.compilers.cxxflags }}"
CC="{{ .dev.compilers.cc }}"
CXX="{{ .dev.compilers.cxx }}"

# Argument parsing
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-update)
      SKIP_UPDATE=true
      shift
      ;;
    --force-new)
      FORCE_NEW=true
      shift
      ;;
    --install)
      INSTALL=true
      shift
      ;;
    --shallow)
      SHALLOW_CLONE=true
      SKIP_UPDATE=true
      shift
      ;;
    --all-arches)
      LLVM_TARGETS=all
      shift
      ;;
    --no-build)
      NO_BUILD=true
      shift
      ;;
    --projects)
      if [[ -z "$2" || "$2" == --* ]]; then
        print -u2 "Error: --projects requires a semicolon-separated value"
        exit 1
      fi
      LLVM_PROJECTS="${2//,/;}"
      shift 2
      ;;
    --runtimes)
      if [[ -z "$2" || "$2" == --* ]]; then
        print -u2 "Error: --runtimes requires a semicolon-separated value"
        exit 1
      fi
      LLVM_RUNTIMES="${2//,/;}"
      shift 2
      ;;
    --all-buildable-thingies-yes-i-know-what-i-am-doing-and-that-this-can-take-a-LONG-LONG-time)
      LLVM_PROJECTS="bolt;clang;clang-tools-extra;cross-project-tests;lld;lldb;mlir;polly"
      LLVM_RUNTIMES="all"
      shift
      ;;
    --c-flags)
      if [[ -z "$2" || "$2" == --* ]]; then
        print -u2 "Error: --cfalgs requires a string"
        exit 1
      fi
      CFLAGS="$2"
      shift 2
      ;;
    --cxx-flags)
      if [[ -z "$2" || "$2" == --* ]]; then
        print -u2 "Error: --cxxfalgs requires a string"
        exit 1
      fi
      CXXFLAGS="$2"
      shift 2
      ;;
    -cc)
      if [[ -z "$2" || "$2" == --* ]]; then
        print -u2 "Error: -cc requires a string"
        exit 1
      fi
      CC="$2"
      shift 2
      ;;
    -cxx)
      if [[ -z "$2" || "$2" == --* ]]; then
        print -u2 "Error: -cxx requires a string"
        exit 1
      fi
      CXX="$2"
      shift 2
      ;;
    --install-dir-suffix)
      if [[ -z "$2" || "$2" == --* ]]; then
        print -u2 "Error: --install-dir-suffix requires a string"
        exit 1
      fi
      INST_DIR_SUFFIX="$2"
      shift 2
      ;;
    *)
      print -u2 "Unknown argument: $1"
      exit 1
      ;;
  esac
done

clone_dir="{{ .dev.directories.clone_dir }}"
repo_dir="$clone_dir/llvm-project"

mkdir -p "$clone_dir"
cd "$clone_dir"

updated=0

if [[ -d "$repo_dir/.git" ]]; then
  cd "$repo_dir"
  if [[ "$SKIP_UPDATE" == false ]]; then
    if git rev-parse --is-shallow-repository | grep -q true; then
      git fetch --unshallow
    fi
    git pull
    updated=1
  fi
else
  if [[ "$SHALLOW_CLONE" == true ]]; then
    git clone git@github.com:llvm/llvm-project.git --depth=1
  else
    git clone git@github.com:llvm/llvm-project.git
  fi
  cd "$repo_dir"
fi

if [[ "$FORCE_NEW" == true ]]; then
  echo "Removing llvm build directory..."
  rm -rf build
fi

mkdir -p build
cd build

cmake_cmd=(
  cmake
  -G Ninja
  -D CMAKE_BUILD_TYPE=Release
  -D CMAKE_C_COMPILER=$CC
  -D CMAKE_CXX_COMPILER=$CXX
  -D CMAKE_C_FLAGS="$CFLAGS"
  -D CMAKE_CXX_FLAGS="$CXXFLAGS"
  -D CMAKE_C_COMPILER_LAUNCHER=ccache
  -D CMAKE_INSTALL_PREFIX="{{ .dev.directories.source_install_dir }}$INST_DIR_SUFFIX"
  -D LLVM_TARGETS_TO_BUILD="$LLVM_TARGETS"
  -D LLVM_ENABLE_PROJECTS="$LLVM_PROJECTS"
  -D LLVM_ENABLE_RUNTIMES="$LLVM_RUNTIMES"
  -D LLVM_PARALLEL_COMPILE_JOBS="{{ .cpu.threads }}"
  -D LLVM_PARALLEL_LINK_JOBS=2
  -D LLVM_PARALLEL_TABLEGEN_JOBS=2
  -D LLVM_CCACHE_BUILD=true
  -D LLVM_BUILD_BENCHMARKS=false
  -D LLVM_INCLUDE_BENCHMARKS=false
  -D LLVM_BUILD_EXAMPLES=true
  -D LLVM_BUILD_TOOLS=true
  -D LLVM_ENABLE_BINDINGS=false
  -D LLVM_ENABLE_LIBCXX=false
  -D LLVM_BUILD_DOCS=true
  -D LLVM_ENABLE_LTO=Off
  -D LLVM_ENABLE_ZLIB=FORCE_ON
  -D LLVM_ENABLE_ZSTD=FORCE_ON
  -D LLDB_ENABLE_LIBEDIT=true
  -D LLDB_ENABLE_CURSES=true
  -D LLDB_ENABLE_LZMA=false
  -D LLDB_ENABLE_LIBXML2=false
  -D LLDB_ENABLE_PYTHON=true
  -D LLDB_ENABLE_LUA=true
  -D LLDB_USE_SYSTEM_DEBUGSERVER=ON
  ../llvm
)

cmd_file="cmake.cmd.txt"
current_cmd="${(j: :)cmake_cmd}"

run_cmake=true

if [[ -f "$cmd_file" ]]; then
  stored_cmd="$(<"$cmd_file")"
  if [[ "$stored_cmd" == "$current_cmd" ]]; then
    run_cmake=false
    if [[ "$updated" == "1" ]]; then
      run_cmake=true
    fi
  fi
fi

if [[ "$run_cmake" == true ]]; then
  print "$current_cmd" > "$cmd_file"
  "${cmake_cmd[@]}"
fi

if [[ "$NO_BUILD" == true ]]; then
    echo "Please go to the directory '$repo_dir/build' and run ninja manually!"
    exit 0
fi

if [[ "$INSTALL" == true ]]; then
  ninja install
else
  ninja
fi
